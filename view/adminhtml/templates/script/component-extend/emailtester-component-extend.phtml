<?php

declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Backend\Block\Template;

/** @version 1.8.3 */
/** @var Template $block */
/** @var Escaper $escaper */

$previewUrl = $block->getUrl('*/*/preview');
$sendUrl = $block->getUrl('*/*/send');
?>
<script>
    LokiComponentExtender.add('ExampleMixin', () => {
        return {
            preview() {
                const params = this.getEmailTesterParameters();
                if (!params) {
                    return;
                }

                const url = '<?= $escaper->escapeJs($previewUrl) ?>?' + new URLSearchParams(params).toString();
                window.open(url);
            },
            send() {
                const params = this.getEmailTesterParameters();
                if (!params) {
                    return;
                }

                const form = document.createElement('form');
                form.method = 'post';
                form.action = '<?= $escaper->escapeJs($sendUrl) ?>';
                form.target = '_blank';
                params['form_key'] = '<?= $escaper->escapeJs($block->getFormKey()) ?>';

                for (const [name, value] of Object.entries(params)) {
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = name;
                    input.value = value;
                    form.appendChild(input);
                }

                document.body.appendChild(form);
                form.submit();
                form.remove();
            },
            addError(message) {
                Alpine.store('Message').addMessage('error', message);
            },
            getEmailTesterParameters() {
                const fields = {
                    'mail_from': 'Sender',
                    'mail_to': 'Recipient',
                    'store_id': 'Store ID',
                    'template': 'Email Template',
                    'customer_id': 'Customer',
                    'product_id': 'Product',
                    'order_id': 'Order',
                };

                let valid = true;
                const values = {};

                for (const [key, label] of Object.entries(fields)) {
                    if (!this.item[key]) {
                        this.addError('Please add a valid ' + label);
                        valid = false;
                        return false;
                    }

                    values[key] = this.item[key];
                }

                if (!valid) {
                    return false;
                }

                return values;
            }
        };
    });
</script>
